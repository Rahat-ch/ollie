# Copy to .env.local for development. Real values are set as Coolify
# environment variables in production; never commit them.

# Directory where generated Ollie audio is written. In production this is the
# Coolify named volume mount; locally it falls back to ./data/audio (gitignored).
AUDIO_DIR=

# Where the Content Pool grows at run time (Stories written live for a
# missing variant). Defaults to stories.json inside AUDIO_DIR, so it lives on
# the same persistent volume as the audio those Stories will be voiced with.
POOL_FILE=

# Anthropic API key used by the Coach and Story generation. Optional at boot;
# the adapters that need it fail loudly when called without it.
ANTHROPIC_API_KEY=

# ElevenLabs API key used to voice Ollie. Optional at boot; the route that
# needs it answers 503 without it and the browser falls through the speech
# chain, so no Session ever blocks on ElevenLabs.
ELEVENLABS_API_KEY=

# The voice designed for Ollie in ElevenLabs Voice Design, printed by
# `pnpm voice:design --save <preview id>`. Never hard-coded: without it Ollie
# has no voice and the chain falls through.
ELEVENLABS_VOICE_ID=

# The text-to-speech model Ollie is rendered on. Defaults to eleven_v3, the
# one with audio tags; eleven_flash_v2_5 is cheaper and has none.
ELEVENLABS_MODEL_ID=
