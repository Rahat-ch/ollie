# Keep the build context to what `pnpm install` and `next build` need.

# dependencies and build output (rebuilt inside the image)
node_modules
.next
out
build
coverage
*.tsbuildinfo
next-env.d.ts

# version control, agent state, planning docs
.git
.gitignore
.scratch
.claude
.agents
skills-lock.json
docs
*.md

# secrets and local env files: never enter the image; set them in Coolify
.env*

# tests and their artifacts (unit tests under src/ stay, they are type-checked)
e2e
test-results
playwright-report
blob-report

# local stand-in for the Coolify audio volume
data

# OS / editor noise
.DS_Store
*.log
*.pem
